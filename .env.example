# Copie para .env e preencha. O .env nunca vai para o Git.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Alternativa (Groq):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Opcionais. Descomente só para mudar o padrão. Os caminhos padrão ficam dentro da pasta do
# repositório; se você informar um caminho relativo, ele vale a partir de onde o comando roda,
# então prefira caminho absoluto.
# Onde fica o SQLite gerado por `python -m analista.dados` (padrão: data/pedidos.db).
# BANCO_PATH=
# Pasta dos rastros (um .jsonl por pergunta) e do contador do teto diário do painel (padrão: runs/).
# RUNS_PATH=
# Resultado que a aba Avaliação do painel lê (padrão: avaliacao/resultados/ultima.json). Só o
# painel usa esta variável: `python -m avaliacao.avaliar` grava sempre em avaliacao/resultados/.
# AVALIACAO_PATH=
# Perguntas por sessão do painel (padrão: 10).
# LIMITE_SESSAO=10
# Perguntas por dia no painel inteiro (padrão: 200). Zera à meia-noite do relógio do servidor.
# LIMITE_DIA=200
